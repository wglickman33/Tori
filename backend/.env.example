PORT=3001
NODE_ENV=development

# Postgres connection string (local or Supabase Postgres host only; no Supabase Auth/SDK).
# Examples (replace with your own; never commit a real password):
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/tori
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Generate with: openssl rand -base64 48
# Access and refresh secrets MUST be different.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Local: http://localhost:5173
# Production (Render): https://torihome.netlify.app
FRONTEND_URL=http://localhost:5173

# Optional in local dev (falls back to backend/uploads). Required for production images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# EmailJS: server-side password reset only. Never put these in the frontend.
# Copy IDs/keys from your EmailJS dashboard; leave blank in git.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID_RESET=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Tori AI chat. Server-side only. Never put this in the Vite frontend.
# https://console.groq.com
GROQ_API_KEY=
