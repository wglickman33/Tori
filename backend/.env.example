PORT=3001
NODE_ENV=development
# Local Homebrew Postgres often uses your macOS username (no password):
# DATABASE_URL=postgresql://YOUR_USER@localhost:5432/tori
# Supabase (Postgres host only — do not use Supabase Auth/SDK):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tori
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Local: http://localhost:5173
# Production (Render): https://torihome.netlify.app  — used for CORS + password-reset links
FRONTEND_URL=http://localhost:5173
# Optional in local dev (falls back to backend/uploads). Required for production image hosting.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# EmailJS (server-side password reset). Never expose the private key to the frontend.
EMAILJS_SERVICE_ID=service_r4eg4b7
EMAILJS_TEMPLATE_ID_RESET=template_42lcv7l
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
